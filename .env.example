[TEMPLATE]
# Copy to .env and fill in your key (never commit .env — safety rule 6)
OPENROUTER_API_KEY=your_key_here

# Optional overrides (defaults shown — free-model slugs rotate often on OpenRouter,
# check https://openrouter.ai/models?max_price=0 if calls start failing with 404)
# OPENROUTER_MODEL=minimax/minimax-m3:free
# OPENROUTER_MODEL_FALLBACKS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# LLM_TIMEOUT_SECONDS=45
# COLLECTOR_TIMEOUT_SECONDS=45
# REQUEST_DELAY_SECONDS=1.0
# Geocode coordinates for cities outside the built-in tables (OSM Nominatim, ≤1 req/s)
# NOMINATIM_GEOCODE=true
